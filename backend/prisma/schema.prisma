// ==========================================
// Prisma Schema - Smart Garden IoT
// ==========================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ==========================================
// ENUMS
// ==========================================

// Chế độ tưới của vườn
enum IrrigationMode {
  manual    // Chỉ tưới thủ công
  auto      // Tự động theo độ ẩm
  periodic  // Tưới theo chu kỳ (mỗi X giờ)
  scheduled // Tưới theo lịch (ngày/giờ cụ thể)
}

// Vai trò người dùng
enum RoleName {
  admin
  user
}

// ==========================================
// TABLES
// ==========================================

// Bảng Role - Phân quyền
model Role {
  id       Int      @id @default(autoincrement())
  roleName RoleName @unique @default(user)

  // Relations
  users User[]

  @@map("roles") // Tên bảng trong DB là "roles"
}

// Bảng User - Người dùng
model User {
  id        Int      @id @default(autoincrement())
  username  String   @unique @db.VarChar(50)
  email     String   @unique @db.VarChar(100)
  password  String   @db.VarChar(255)
  roleId    Int      @default(2) // Default là user
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  role    Role     @relation(fields: [roleId], references: [id])
  gardens Garden[]
  plants  Plant[]  @relation("PlantCreatedBy") // Admin tạo Plant

  @@map("users")
}

// Bảng Plant - Từ điển cây trồng (Admin quản lý)
model Plant {
  id              Int      @id @default(autoincrement())
  name            String   @db.VarChar(100)
  description     String?   @db.Text
  
  // Ngưỡng nhiệt độ lý tưởng (°C)
  minTemperature  Float    @default(15)
  maxTemperature  Float    @default(35)
  
  // Ngưỡng độ ẩm không khí lý tưởng (%)
  minAirHumidity  Float    @default(40)
  maxAirHumidity  Float    @default(80)
  
  // Ngưỡng độ ẩm đất lý tưởng (%)
  minSoilMoisture Float    @default(30)
  maxSoilMoisture Float    @default(70)
  
  createdById     Int? 
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  // Relations
  createdBy       User?    @relation("PlantCreatedBy", fields: [createdById], references: [id])
  gardens         Garden[]

  @@map("plants")
}

// Bảng Device - Thiết bị ESP32
model Device {
  id            Int      @id @default(autoincrement())
  deviceCode    String   @unique @db.VarChar(50) // VD:  "ESP32_001"
  
  // Dữ liệu cảm biến real-time (cập nhật mỗi 3 giây từ ESP32)
  temperature   Float?    // Nhiệt độ (°C)
  airHumidity   Float?   // Độ ẩm không khí (%)
  soilMoisture  Float?   // Độ ẩm đất (%)
  isDark        Boolean  @default(false) // Cảm biến ánh sáng (true = tối)
  
  // Trạng thái thiết bị điều khiển
  isPumpOn      Boolean  @default(false)
  isLedOn       Boolean  @default(false)
  
  // Trạng thái kết nối
  isConnected   Boolean  @default(false)
  lastSeen      DateTime? // Lần cuối nhận data từ ESP32
  
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  // Relations
  garden        Garden? 

  @@map("devices")
}

// Bảng Garden - Vườn cây
model Garden {
  id              Int            @id @default(autoincrement())
  gardenName      String         @db.VarChar(100)
  description     String?        @db.Text
  
  // Chế độ tưới
  irrigationMode  IrrigationMode @default(manual)
  
  // Cài đặt tưới tự động (mode = auto)
  // Tưới khi độ ẩm đất < ngưỡng này
  autoIrrigationThreshold Float  @default(30)
  // Thời gian bơm mỗi lần (giây)
  autoIrrigationDuration  Int    @default(60)
  
  // Cài đặt tưới theo chu kỳ (mode = periodic)
  // Tưới mỗi X giờ
  periodicIntervalHours   Int    @default(24)
  // Lần tưới cuối cùng
  periodicLastIrrigation  DateTime?
  
  // Cài đặt tự động bật đèn khi tối
  ledAutoMode     Boolean  @default(false)
  
  // Ngưỡng cảnh báo (copy từ Plant khi tạo, user có thể tùy chỉnh)
  alertMinTemperature  Float @default(15)
  alertMaxTemperature  Float @default(35)
  alertMinSoilMoisture Float @default(20)
  
  // Foreign keys
  userId          Int
  plantId         Int? 
  deviceId        Int?     @unique
  
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  // Relations
  user            User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  plant           Plant?         @relation(fields: [plantId], references: [id])
  device          Device?        @relation(fields: [deviceId], references: [id])
  sensorLogs      SensorLog[]
  irrigationLogs  IrrigationLog[]
  schedules       Schedule[]
  irrigation      Irrigation? 

  @@map("gardens")
}

// Bảng SensorLog - Lịch sử dữ liệu cảm biến (lưu mỗi 5 phút)
model SensorLog {
  id            Int      @id @default(autoincrement())
  gardenId      Int
  
  temperature   Float? 
  airHumidity   Float?
  soilMoisture  Float? 
  isDark        Boolean? 
  
  recordedAt    DateTime @default(now())

  // Relations
  garden        Garden   @relation(fields: [gardenId], references: [id], onDelete: Cascade)

  // Index để query nhanh theo garden và thời gian
  @@index([gardenId, recordedAt])
  @@map("sensor_logs")
}

// Bảng IrrigationLog - Lịch sử tưới
model IrrigationLog {
  id              Int      @id @default(autoincrement())
  gardenId        Int
  
  // Thời gian bắt đầu tưới
  startTime       DateTime @default(now())
  // Thời gian kết thúc (null nếu đang tưới)
  endTime         DateTime?
  // Thời lượng thực tế (giây)
  duration        Int? 
  // Chế độ tưới khi đó
  mode            IrrigationMode
  // Trạng thái:  started, completed, failed
  status          String   @db.VarChar(20)
  // Ghi chú (VD: "Tưới tự động do độ ẩm = 25%")
  note            String?  @db.Text

  // Relations
  garden          Garden   @relation(fields: [gardenId], references: [id], onDelete: Cascade)

  @@index([gardenId, startTime])
  @@map("irrigation_logs")
}

// Bảng Irrigation - Trạng thái tưới hiện tại của vườn
model Irrigation {
  id          Int      @id @default(autoincrement())
  gardenId    Int      @unique
  
  // Đang tưới hay không
  isActive    Boolean  @default(false)
  // Thời gian bắt đầu phiên tưới hiện tại
  startTime   DateTime? 
  // Chế độ tưới hiện tại
  mode        IrrigationMode? 
  
  // Relations
  garden      Garden   @relation(fields: [gardenId], references: [id], onDelete:  Cascade)

  @@map("irrigations")
}

// Bảng Schedule - Lịch tưới theo ngày/giờ
model Schedule {
  id          Int      @id @default(autoincrement())
  gardenId    Int
  
  // Giờ tưới (format: "HH:mm")
  time        String   @db.VarChar(5)
  // Ngày trong tuần (0=CN, 1=T2, .. ., 6=T7)
  // Lưu dạng JSON array:  [1,3,5] = T2, T4, T6
  daysOfWeek  String   @db.VarChar(20) // "[0,1,2,3,4,5,6]"
  // Thời lượng tưới (giây)
  duration    Int      @default(60)
  // Bật/tắt lịch này
  enabled     Boolean  @default(true)
  
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Relations
  garden      Garden   @relation(fields: [gardenId], references: [id], onDelete:  Cascade)

  @@map("schedules")
}